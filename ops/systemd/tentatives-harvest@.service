# Copy to /etc/systemd/system/ on courtproj (docs/harvest.md).
[Unit]
Description=tentatives %i harvest (aimesy/tentatives ops/courtproj-harvest.sh)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# TENTATIVES_TOKEN_FILE and TENTATIVES_CREDENTIAL_HELPER; never the token itself.
Environment="TENTATIVES_PRIMARY_LANES=pi26c104 pi26c101"
EnvironmentFile=/etc/tentatives-harvest.env
# Every court fetch goes through a Surfshark or PIA lane, never courtproj's own
# IP (Amy, 2026-11-18). vpn-lane-exec (ops/vpn-lane-exec, installed in
# /usr/local/sbin) runs the harvest in the first lane that is up and exits 75,
# running nothing, if none is.
ExecStart=/usr/local/sbin/vpn-lane-exec $TENTATIVES_PRIMARY_LANES -- /usr/local/sbin/tentatives-harvest %i
# The harvest takes what is left over from other services.
Nice=19
IOSchedulingClass=idle
CPUWeight=10
CPUQuota=100%
IOWeight=10
MemoryHigh=4G
MemoryMax=8G
MemorySwapMax=0
IPAccounting=yes
TimeoutStartSec=6h
StandardOutput=append:/var/log/tentatives-harvest.log
StandardError=append:/var/log/tentatives-harvest.log
