[Unit]
Description=Retired aimesy/tentatives VPS live harvest

[Timer]
# Retired. The canonical schedule is .github/workflows/backfill.yml.
# This timer is kept only so old install notes point at a harmless no-op unit.
OnCalendar=*-*-* 00:00:00 UTC
OnCalendar=*-*-* 01:00:00 UTC
Persistent=true
RandomizedDelaySec=2m

[Install]
WantedBy=timers.target
