#!/usr/bin/env bash
# Starts one tentatives harvest on courtproj (docs/harvest.md). Installed as
# /usr/local/sbin/tentatives-harvest and run by tentatives-harvest@.service.
# It clones aimesy/tentatives into a fresh work directory and runs that
# checkout's ops/courtproj-harvest.sh, so a push to the code repository
# changes the next harvest without touching courtproj.
set -euo pipefail
MODE="${1:-live}"
case "$MODE" in
  live|wayback) ;;
  *) echo "usage: tentatives-harvest live|wayback" >&2; exit 2 ;;
esac
exec 9>/run/lock/tentatives-harvest.lock
if ! flock -n 9; then
  echo "another tentatives harvest is running" >&2
  exit 0
fi
WORK="$(mktemp -d /var/tmp/tentatives-harvest.XXXXXX)"
# Court files stay on courtproj only for the length of a run. Retry, in case a
# git process is still finishing inside the clone.
cleanup() {
  local attempt
  for attempt in 1 2 3 4 5 6; do
    rm -rf -- "$WORK" 2>/dev/null && return 0
    sleep 10
  done
  echo "could not remove $WORK" >&2
}
trap cleanup EXIT
trap 'exit 143' TERM
trap 'exit 130' INT
echo "== $(date -u +%FT%TZ) tentatives $MODE harvest in $WORK"
git clone -q --depth 1 "https://github.com/${TENTATIVES_CODE_REPO:-aimesy/tentatives}.git" "$WORK/code"
status=0
bash "$WORK/code/ops/courtproj-harvest.sh" "$WORK" "$MODE" || status=$?
mkdir -p /var/log/tentatives-harvest
for log in backfill parse; do
  [ -f "$WORK/$log.log" ] && cp "$WORK/$log.log" "/var/log/tentatives-harvest/$(date -u +%Y%m%dT%H%MZ)-$MODE-$log.log"
done
exit "$status"
