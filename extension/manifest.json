{
  "manifest_version": 3,
  "name": "Tentatives Capture",
  "version": "0.3.0",
  "description": "Capture California superior court tentative rulings PDFs to a GitHub archive. Single-page upload or bulk scan across every dept.",

  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://*.eldorado.courts.ca.gov/*",
    "https://*.placer.courts.ca.gov/*",
    "https://*.contracosta.courts.ca.gov/*",
    "https://*.cc-courts.org/*",
    "https://api.github.com/*",
    "https://web.archive.org/*"
  ],

  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"],
    "type": "module"
  },

  "action": {
    "default_title": "Tentatives Capture",
    "default_popup": "popup/popup.html"
  },

  "options_page": "options/options.html",

  "content_scripts": [
    {
      "matches": [
        "https://*.eldorado.courts.ca.gov/online-services/tentative-rulings/*"
      ],
      "js": ["sites/el-dorado.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.placer.courts.ca.gov/*"
      ],
      "js": ["sites/placer.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.contracosta.courts.ca.gov/*",
        "https://*.cc-courts.org/*"
      ],
      "js": ["sites/contra-costa.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
